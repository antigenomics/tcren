    "compositional" [fillcolor="#009E73", fontcolor="white", label="compositional\n64 descriptors\na count over the labelled\ncontact set, or a share of one"];
    "energetic" [fillcolor="#CC79A7", fontcolor="white", label="energetic\n20 descriptors\na statistical-potential\nor Potts energy"];
    "categorical" [fillcolor="#999999", fontcolor="white", label="categorical\n1 descriptor\nwhich class of MHC\npresents the peptide"];
  }

  "placement" -> "geometric" [label="31", penwidth=3.20, color="#0072B2"];
