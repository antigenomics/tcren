digraph arch {
  rankdir=TB; compound=true; splines=spline; bgcolor="white";
  graph [fontname="Helvetica" fontsize=11 nodesep=0.28 ranksep=0.55];
  node [shape=box style="rounded,filled" fontname="Helvetica" fontsize=11 color="#aaaaaa" penwidth=0.8 height=0.3];
  edge [color="#9aa0a6" arrowsize=0.6 penwidth=0.9];
  subgraph cluster_0 {
    label="0. structure"; labeljust=l; fontsize=14; fontname="Helvetica-Bold";
    style="rounded,filled"; fillcolor="#e8f0f8"; color="#cfcfcf";
    "annotation" [fillcolor="white"];
    "mhc" [fillcolor="white"];
    "structure" [fillcolor="white"];
  }
